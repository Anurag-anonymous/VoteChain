PORT=5100
HOST=127.0.0.1
NODE_ENV=development

# Prefer `npm run setup` to generate secure values and matching VoteChain keys.
# Use a long, unique administrator password and a random 32-byte hex key.
ELIGIBILITY_AUTHORITY_ADMIN_PASSWORD=replace-with-a-long-unique-password
ELIGIBILITY_AUTHORITY_DATA_KEY=replace-with-64-hex-characters

# Independently generated, matching secrets in the VoteChain backend configuration.
VOTECHAIN_ENROLLMENT_HMAC_SECRET=replace-with-at-least-32-random-bytes
VOTECHAIN_CALLBACK_URL=http://127.0.0.1:5000/api/eligibility-authority/decision
VOTECHAIN_CALLBACK_HMAC_SECRET=replace-with-at-least-32-random-bytes
