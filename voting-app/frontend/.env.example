REACT_APP_API_URL=http://localhost:5000

# Switch between local Anvil testing and Polygon Amoy.
# For local testing: set BLOCKCHAIN_NETWORK=anvil and use local RPC/chain values below.
# For Polygon Amoy: set BLOCKCHAIN_NETWORK=amoy and update the values below.
REACT_APP_BLOCKCHAIN_NETWORK=anvil
REACT_APP_POLYGON_RPC=http://127.0.0.1:8545
REACT_APP_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
REACT_APP_CHAIN_ID=31337
REACT_APP_NETWORK_NAME=Anvil
REACT_APP_NATIVE_CURRENCY_NAME=ETH
REACT_APP_NATIVE_CURRENCY_SYMBOL=ETH
REACT_APP_BLOCK_EXPLORER_URLS=

# Polygon Amoy example:
# REACT_APP_BLOCKCHAIN_NETWORK=amoy
# REACT_APP_POLYGON_RPC=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# REACT_APP_CONTRACT_ADDRESS=0xdB9e17E0C42F8EE87a4bCC48378BBd74d470FdD8
# REACT_APP_CHAIN_ID=80002
# REACT_APP_NETWORK_NAME=Polygon Amoy
# REACT_APP_NATIVE_CURRENCY_NAME=MATIC
# REACT_APP_NATIVE_CURRENCY_SYMBOL=MATIC
# REACT_APP_BLOCK_EXPLORER_URLS=https://amoy.polygonscan.com/
