{
  "name": "voting-app",
  "version": "1.0.0",
  "description": "Blockchain-based voting platform with Aadhar verification",
  "main": "index.js",
  "scripts": {
    "setup:local": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-local.ps1",
    "setup:local:check": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-local.ps1 -NoAutoInstall -SkipInstall -SkipServices -SkipDeploy",
    "setup:c1:on": "powershell -ExecutionPolicy Bypass -File ./scripts/set-c1-mode.ps1 -Mode on",
    "setup:c1:off": "powershell -ExecutionPolicy Bypass -File ./scripts/set-c1-mode.ps1 -Mode off",
    "chain:anvil": "anvil --host 127.0.0.1 --port 8545 --chain-id 31337",
    "chain:c1-receipt": "powershell -ExecutionPolicy Bypass -File ./scripts/show-c1-receipt.ps1",
    "experiment:manifest": "node ./scripts/experiments/create-run-manifest.js",
    "experiment:campaign": "node ./scripts/experiments/create-campaign.js",
    "experiment:plan": "node ./scripts/experiments/create-campaign.js",
    "experiment:run": "cd smart-contracts && npm run experiment:campaign --",
    "experiment:audit": "cd smart-contracts && npm run experiment:audit --",
    "experiment:analyze": "cd smart-contracts && npm run experiment:analyze --",
    "experiment:leakage": "cd smart-contracts && npm run experiment:leakage --",
    "experiment:activity-rates": "cd smart-contracts && npm run experiment:activity-rates --",
    "experiment:export": "cd smart-contracts && npm run experiment:export --",
    "experiment:test": "cd smart-contracts && npm run test:experiments",
    "deploy:anvil": "cd smart-contracts && npm run deploy:anvil",
    "deploy:amoy": "cd smart-contracts && npm run deploy:amoy",
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../smart-contracts && npm install",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm start",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm start",
    "build": "cd frontend && npm run build",
    "test": "concurrently \"npm run test:backend\" \"npm run test:contracts\"",
    "test:backend": "cd backend && npm test",
    "test:contracts": "cd smart-contracts && npm test",
    "test:contracts:amoy": "cd smart-contracts && npm run test:amoy",
    "lint": "concurrently \"cd backend && npm run lint\" \"cd frontend && npm run lint\""
  },
  "keywords": [
    "blockchain",
    "voting",
    "polygon",
    "aadhar",
    "ethereum"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
