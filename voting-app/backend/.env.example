# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Choose one connection mode:
#   local  -> uses MONGODB_LOCAL_URI (or default localhost)
#   atlas  -> uses MONGODB_ATLAS_URI
MONGODB_MODE=local
MONGODB_LOCAL_URI=mongodb://localhost:27017/voting-app
#MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/voting-app

# Optional override: if you already have a full connection string, set this directly
MONGODB_URI=mongodb+srv://panurag526_db_user:PUereMbFA2Y3ccD6@cluster0.dwtn28a.mongodb.net/

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRE=30d

# Aadhar & OTP Configuration
AADHAR_API_KEY=your_aadhar_api_key
AADHAR_API_URL=https://aadhar-api-url
OTP_EXPIRE_TIME=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_LIMIT=3

# Polygon Blockchain Configuration
# For local Anvil testing:
BLOCKCHAIN_NETWORK=anvil
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_CHAIN_ID=31337
ANVIL_VOTING_CONTRACT_ADDRESS=0xe78A0F7E598Cc8b0Bb87894B0F60dD2a88d6a8Ab
# For Polygon Amoy:
# POLYGON_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your_api_key
# POLYGON_CHAIN_ID=80002
# VOTING_CONTRACT_ADDRESS=0xdB9e17E0C42F8EE87a4bCC48378BBd74d470FdD8
POLYGON_WALLET_PRIVATE_KEY=0x4f3edf983ac636a65a842ce7c78d9aa706d3b113bce9c46f30d7d21715b23b1d
POLLING_INTERVAL=15000

# Email Service (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=noreply@votingapp.com
SMTP_FROM_NAME=Voting Platform

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_MAX=3

# CORS
CORS_ORIGIN=http://localhost:3000

# Redis (optional, for sessions)
REDIS_URL=redis://localhost:6379

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png

# Logging
LOG_LEVEL=debug

# Environment
ENVIRONMENT=development
