# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/voting-app
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/voting-app

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRE=30d

# Aadhar & OTP Configuration
AADHAR_API_KEY=your_aadhar_api_key
AADHAR_API_URL=https://aadhar-api-url
OTP_EXPIRE_TIME=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_LIMIT=3

# Polygon Blockchain Configuration
POLYGON_RPC_URL=https://rpc-mumbai.maticvigil.com
POLYGON_CHAIN_ID=80001
POLYGON_WALLET_PRIVATE_KEY=your_wallet_private_key
VOTING_CONTRACT_ADDRESS=0x...
POLLING_INTERVAL=15000

# Email Service (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=noreply@votingapp.com
SMTP_FROM_NAME=Voting Platform

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_MAX=3

# CORS
CORS_ORIGIN=http://localhost:3000

# Redis (optional, for sessions)
REDIS_URL=redis://localhost:6379

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png

# Logging
LOG_LEVEL=debug

# Environment
ENVIRONMENT=development
