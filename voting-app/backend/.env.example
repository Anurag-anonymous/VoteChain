PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

MONGODB_MODE=local
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/voting-app

JWT_SECRET=development-jwt-secret-change-me
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=development-refresh-secret-change-me
REFRESH_TOKEN_EXPIRE=30d

BLOCKCHAIN_NETWORK=anvil
BLOCKCHAIN_ENABLED=true
DATABASE_ENABLED=true
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_CHAIN_ID=31337
ANVIL_VOTING_CONTRACT_ADDRESS=
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
LOCAL_WALLET_MIN_BALANCE=0.1
LOCAL_WALLET_FUND_AMOUNT=1

# Polygon Amoy testnet (chain ID 80002). Required only when
# BLOCKCHAIN_NETWORK=polygon-amoy. Mumbai (80001) is retired.
# Local private-key signing is refused on public networks, so the backend never
# signs for a user there; see backend/src/config/networks.js.
POLYGON_RPC_URL=
POLYGON_CHAIN_ID=80002
POLYGON_WALLET_PRIVATE_KEY=
POLYGON_NETWORK_NAME=Polygon Amoy
VOTING_CONTRACT_ADDRESS=

# C0 encrypted voting baseline.
# Set to false to disable creating and voting on encrypted C0 polls.
C0_PROTOCOL_ENABLED=true
# Backward-compatible legacy name. C0_PROTOCOL_ENABLED takes precedence.
RESEARCH_PROTOCOL_ENABLED=true
# Development trustee share threshold required before a tally can be finalized.
RESEARCH_TALLY_THRESHOLD=1
# Research default: one trustee. Set threshold-3-of-5 to enable the retained
# multi-trustee coordinator for future campaigns.
RESEARCH_TALLY_MODE=single
# Server-side secrets for election-scoped credentials and AES-256-GCM ballots.
# Use long random values outside local development.
C0_CREDENTIAL_ISSUER_SECRET=change-me-c0-credential-secret
C0_BALLOT_ENCRYPTION_SECRET=change-me-c0-ballot-encryption-secret
JCJ_PROTOCOL_ENABLED=false
ELECTION_BALLOT_ENCRYPTION_MODE=aes-256-gcm
# 32 random bytes encoded as 64 hex characters. Required for persistent C2/C3
# credential classification; keep it stable and separate from the other keys.
# Local setup generates a stable value in backend/.env automatically.
C2_REGISTRY_ENCRYPTION_KEY=replace-with-64-hex-characters

# Independent human eligibility authority integration.
# Use separate random values of at least 32 characters.
ELIGIBILITY_AUTHORITY_URL=http://127.0.0.1:5100
ELIGIBILITY_AUTHORITY_ENROLLMENT_SECRET=replace-with-a-unique-32-byte-secret
ELIGIBILITY_AUTHORITY_CALLBACK_SECRET=replace-with-a-different-unique-32-byte-secret
ELIGIBILITY_AUTHORITY_CREDENTIAL_KEY=replace-with-a-third-unique-32-byte-hex-key

# C1 on-chain encrypted-ballot receipt anchoring.
# Keep false for C0 database-only encrypted ballots.
C1_CHAIN_RECEIPTS_ENABLED=false
C1_ENCRYPTED_BALLOT_REGISTRY_ADDRESS=
C1_REVOTING_ENABLED=false

OTP_EXPIRE_TIME=10
OTP_MAX_ATTEMPTS=5

AADHAR_API_KEY=
AADHAR_API_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@votechain.local
SMTP_FROM_NAME=VoteChain

SMS_API_URL=
SMS_API_KEY=
