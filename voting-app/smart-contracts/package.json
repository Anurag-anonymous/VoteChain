{
  "name": "voting-app-contracts",
  "version": "1.0.0",
  "description": "Smart contracts for blockchain voting platform",
  "main": "index.js",
  "scripts": {
    "compile": "truffle compile",
    "migrate": "truffle migrate",
    "migrate:reset": "truffle migrate --reset",
    "deploy:anvil": "truffle migrate --network anvil --reset",
    "deploy:amoy": "truffle migrate --network polygon-amoy --reset",
    "test": "truffle test test/election_ballot_box_test.js test/modular_election_test.js test/research_election_test.js",
    "test:experiments": "node --test ./scripts/experiments/pipeline.test.js ./scripts/experiments/export-study-csv.test.js ./scripts/experiments/leakage-analysis.test.js ./scripts/experiments/activity-rate-analysis.test.js",
    "test:amoy": "truffle test --network polygon-amoy",
    "experiment:campaign": "node ./scripts/experiments/run-campaign.js",
    "experiment:audit": "node ./scripts/experiments/audit-run.js",
    "experiment:analyze": "node ./scripts/experiments/analyze-campaign.js",
    "experiment:leakage": "node ./scripts/experiments/analyze-leakage.js",
    "experiment:activity-rates": "node ./scripts/experiments/analyze-activity-rates.js",
    "experiment:export": "node ./scripts/experiments/export-study-csv.js",
    "develop": "truffle develop"
  },
  "keywords": [
    "blockchain",
    "voting",
    "polygon",
    "ethereum",
    "solidity",
    "truffle"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@openzeppelin/contracts": "^4.9.0",
    "@truffle/hdwallet-provider": "^2.1.1",
    "dotenv": "^16.0.3",
    "ganache": "^7.9.2",
    "truffle": "^5.10.0",
    "truffle-assertions": "^0.9.2"
  }
}
